# =============================================================================
# LLM Archive - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Node environment: development | production | test
NODE_ENV=development

# Server port (default: 5000)
PORT=5000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?sslmode=require
# 
# Local development example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/llm_archive
#
# Render PostgreSQL example:
# DATABASE_URL=postgresql://user:pass@dpg-xxxxx.oregon-postgres.render.com/llm_archive
#
# Neon PostgreSQL example:
# DATABASE_URL=postgresql://user:pass@ep-xxxxx.us-east-2.aws.neon.tech/llmarchive?sslmode=require

DATABASE_URL=postgresql://postgres:password@localhost:5432/llm_archive

# =============================================================================
# SESSION & SECURITY
# =============================================================================

# Session secret (generate with: openssl rand -hex 32)
# IMPORTANT: Use a strong random string in production!
SESSION_SECRET=your-super-secret-session-key-change-this-in-production-32-chars

# Session cookie name (optional, default: connect.sid)
# SESSION_NAME=llm_archive_session

# Session cookie max age in milliseconds (optional, default: 24 hours)
# SESSION_MAX_AGE=86400000

# =============================================================================
# AUTHENTICATION (Optional - for OAuth features)
# =============================================================================

# Google OAuth credentials
# Get from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth callback URL (update for production)
# OAUTH_CALLBACK_URL=http://localhost:5000/auth/google/callback

# JWT secret for extension authentication
# JWT_SECRET=your-jwt-secret-key-change-this

# JWT expiration time (default: 30 days)
# JWT_EXPIRES_IN=30d

# =============================================================================
# CORS CONFIGURATION (for split deployment)
# =============================================================================

# Allowed CORS origins (comma-separated for multiple origins)
# Development:
# CORS_ORIGIN=http://localhost:5173
#
# Production (Vercel frontend):
# CORS_ORIGIN=https://your-frontend.vercel.app,https://www.yourdomain.com

CORS_ORIGIN=http://localhost:5173

# =============================================================================
# FRONTEND CONFIGURATION (Vite - must be prefixed with VITE_)
# =============================================================================

# API base URL for frontend
# Development (same origin):
# VITE_API_URL=/api
#
# Production (split deployment):
# VITE_API_URL=https://your-backend.onrender.com/api

VITE_API_URL=/api

# App title (optional)
# VITE_APP_TITLE=LLM Archive

# Google Analytics ID (optional)
# VITE_GA_ID=G-XXXXXXXXXX

# =============================================================================
# RATE LIMITING (Optional)
# =============================================================================

# Rate limit window in milliseconds (default: 15 minutes)
# RATE_LIMIT_WINDOW=900000

# Max requests per window (default: 100)
# RATE_LIMIT_MAX=100

# =============================================================================
# FILE UPLOAD (Optional)
# =============================================================================

# Max file upload size in bytes (default: 5MB)
# MAX_FILE_SIZE=5242880

# Allowed file types (comma-separated)
# ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# =============================================================================
# LOGGING (Optional)
# =============================================================================

# Log level: error | warn | info | debug
# LOG_LEVEL=info

# Enable request logging (true/false)
# LOG_REQUESTS=true

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Redis URL for caching/sessions (if using Redis)
# REDIS_URL=redis://localhost:6379

# SendGrid API key for email notifications
# SENDGRID_API_KEY=SG.xxxxx

# Cloudinary for image hosting
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Enable debug mode (shows detailed error messages)
# DEBUG=true

# Drizzle Studio port (default: 4983)
# DRIZZLE_STUDIO_PORT=4983

# =============================================================================
# PRODUCTION DEPLOYMENT
# =============================================================================

# Replit deployment
# REPL_ID=your-repl-id
# REPL_OWNER=your-username
# REPLIT_DB_URL=your-replit-db-url

# Render deployment
# RENDER=true
# RENDER_SERVICE_ID=your-service-id
# RENDER_GIT_COMMIT=commit-hash

# Vercel deployment
# VERCEL=1
# VERCEL_URL=your-deployment-url
# VERCEL_ENV=production

# =============================================================================
# NOTES
# =============================================================================
#
# 1. Required variables for basic setup:
#    - DATABASE_URL
#    - SESSION_SECRET
#    - NODE_ENV
#
# 2. For production deployment:
#    - Generate strong random values for all secrets
#    - Use environment-specific DATABASE_URL
#    - Set NODE_ENV=production
#    - Configure CORS_ORIGIN if using split deployment
#
# 3. For Chrome extension integration:
#    - Extensions will communicate with your API
#    - Ensure CORS is configured correctly
#    - Consider JWT authentication for secured endpoints
#
# 4. Security best practices:
#    - Never commit .env file to git (add to .gitignore)
#    - Use different secrets for dev/staging/production
#    - Rotate secrets regularly
#    - Use minimum required permissions for database users
#
# =============================================================================
