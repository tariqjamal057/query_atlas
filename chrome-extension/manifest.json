{
  "manifest_version": 3,
  "name": "LLM Archive", 
  "version": "1.0.0",
  "key": "",
  "description": "Automatically capture and save AI search results from popular LLM platforms",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "contextMenus",
    "notifications",
    "scripting",
    "alarms",
    "identity",
    "management"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "http://localhost:5000/*",
    "https://*.replit.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LLM Archive"
  },
  "options_page": "options.html",
  "oauth2": {
    "client_id": "89999961014-0fqq881ur4ve9gu8j7p9tafrudamm494.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "profile", 
      "email"
    ]
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
